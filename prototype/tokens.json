{
  "name": "Dewgrid",
  "version": "1.0.0",
  "description": "Night botanic greenhouse grown over living copper-green circuitry. Wet silicon. Dew as current.",
  "contrastBase": {
    "name": "peat",
    "hex": "#06140F"
  },
  "color": {
    "bg": {
      "peat": { "hex": "#06140F", "role": "page background" },
      "canopy": { "hex": "#0C2418", "role": "secondary surface / attract field" },
      "panel": { "hex": "#102C1C", "hexCss": "#102C1CEE", "role": "glass panels" },
      "tunnel": { "hex": "#04110C", "role": "maze path / deep void" }
    },
    "fg": {
      "dew": { "hex": "#E7FFF4", "contrastRatio": 17.95, "vs": "peat" },
      "muted": { "hex": "#9BBAA8", "contrastRatio": 8.96, "vs": "peat" }
    },
    "accent": {
      "circuit": { "hex": "#2FE6A4", "contrastRatio": 11.64, "vs": "peat", "notes": "peat-on-circuit also 11.64:1" },
      "sap": { "hex": "#F4D35E", "contrastRatio": 12.85, "vs": "peat" },
      "sunburst": { "hex": "#FF8A3D", "contrastRatio": 8.03, "vs": "peat" }
    },
    "player": {
      "leaf": { "hex": "#9DFF7A", "contrastRatio": 15.27, "vs": "peat" }
    },
    "enemy": {
      "seek": { "hex": "#FF5A73", "contrastRatio": 6.25, "vs": "peat", "shape": "rounded-rect" },
      "weave": { "hex": "#5EC8FF", "contrastRatio": 10.03, "vs": "peat", "shape": "diamond" },
      "nest": { "hex": "#C084FC", "contrastRatio": 7.13, "vs": "peat", "shape": "circle" },
      "dart": { "hex": "#FFCC4D", "contrastRatio": 12.56, "vs": "peat", "shape": "chevron" }
    },
    "wall": {
      "trace": { "hex": "#1E5A3E", "role": "moss-trace borders" },
      "moss": { "hex": "#0A2A1C", "role": "wall fill" }
    },
    "copper": { "hex": "#B87333", "role": "traces only — not body text", "useSparingly": true }
  },
  "typography": {
    "display": {
      "family": "Fraunces",
      "fallback": ["Georgia", "Times New Roman", "serif"],
      "weight": 600,
      "sizeScale": [12, 14, 16, 20, 28, 40, 56],
      "letterSpacingWordmark": "0.14em"
    },
    "ui": {
      "family": "Spline Sans Mono",
      "fallback": ["ui-monospace", "Cascadia Code", "monospace"],
      "sizeScale": [12, 14, 16]
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": {
    "chip": 2,
    "panel": 10,
    "pill": 999
  },
  "elevation": {
    "mossInner": "inset moss glow on peat glass panels",
    "circuitHalo": "soft circuit mint halo; brighten on hover — no generic drop-shadow cards"
  },
  "motion": {
    "pulse": { "durationMs": 2400, "easing": "ease-in-out" },
    "drip": { "durationMs": 6000, "easing": "linear" },
    "bob": { "durationMs": 1600, "easing": "ease-in-out" },
    "reducedMotion": "all animations none / opacity-only"
  },
  "themes": {
    "dark": {
      "bg.peat": "#06140F",
      "bg.canopy": "#0C2418",
      "bg.panel": "#102C1C",
      "bg.tunnel": "#04110C",
      "fg.dew": "#E7FFF4",
      "fg.muted": "#9BBAA8",
      "accent.circuit": "#2FE6A4",
      "accent.sap": "#F4D35E",
      "accent.sunburst": "#FF8A3D",
      "player.leaf": "#9DFF7A",
      "enemy.seek": "#FF5A73",
      "enemy.weave": "#5EC8FF",
      "enemy.nest": "#C084FC",
      "enemy.dart": "#FFCC4D",
      "wall.trace": "#1E5A3E",
      "wall.moss": "#0A2A1C",
      "copper": "#B87333"
    },
    "light": {
      "bg.peat": "#F2FBF6",
      "bg.canopy": "#E4F5EB",
      "bg.panel": "#FFFFFFEE",
      "bg.tunnel": "#D8EDE2",
      "fg.dew": "#0A2A1C",
      "fg.muted": "#3D5C4C",
      "accent.circuit": "#0F9B6A",
      "accent.sap": "#A67C00",
      "accent.sunburst": "#C45A12",
      "player.leaf": "#2E8B3A",
      "enemy.seek": "#C42845",
      "enemy.weave": "#1A7AAD",
      "enemy.nest": "#7A3FB0",
      "enemy.dart": "#A67C00",
      "wall.trace": "#7AAD92",
      "wall.moss": "#B8D4C4",
      "copper": "#8B5A2B"
    }
  },
  "cssVariableMap": {
    "color.bg.peat": "--color-bg-peat",
    "color.bg.canopy": "--color-bg-canopy",
    "color.bg.panel": "--color-bg-panel",
    "color.bg.tunnel": "--color-bg-tunnel",
    "color.fg.dew": "--color-fg-dew",
    "color.fg.muted": "--color-fg-muted",
    "color.accent.circuit": "--color-accent-circuit",
    "color.accent.sap": "--color-accent-sap",
    "color.accent.sunburst": "--color-accent-sunburst",
    "color.player.leaf": "--color-player-leaf",
    "color.enemy.seek": "--color-enemy-seek",
    "color.enemy.weave": "--color-enemy-weave",
    "color.enemy.nest": "--color-enemy-nest",
    "color.enemy.dart": "--color-enemy-dart",
    "color.wall.trace": "--color-wall-trace",
    "color.wall.moss": "--color-wall-moss",
    "color.copper": "--color-copper"
  }
}
